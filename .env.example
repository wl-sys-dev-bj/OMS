# Security & Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave empty to use local SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=oms_db
# DB_USER=oms_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Security Headers (Set to True for production HTTPS deployment)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Company Configuration
COMPANY_NAME=OMS Workforce & People Operations
COMPANY_EMAIL=info@oms-management.com
COMPANY_PHONE=+971 4 000 0000
COMPANY_ADDRESS=Dubai, United Arab Emirates
